{
  "name": "folio-paper-reader",
  "version": "0.4.1",
  "description": "A local-first academic PDF workspace with DeepSeek and Obsidian",
  "author": "Folio",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node scripts/e2e.mjs",
    "package:mac": "npm run build && electron-builder --mac dir",
    "dist:mac": "npm run build && electron-builder --mac zip --arm64",
    "dist:dmg": "npm run build && electron-builder --mac dmg --universal",
    "package:win": "npm run build && electron-builder --win dir --x64",
    "dist:win": "npm run build && electron-builder --win --x64",
    "test:win-package": "node scripts/verify-windows.mjs",
    "test:reading": "node scripts/e2e-reading.mjs",
    "test:locale": "node scripts/e2e-locale.mjs",
    "test:voice": "node scripts/e2e-voice.mjs",
    "test:chat-deletion": "node scripts/e2e-chat-deletion.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "esbuild": "latest",
    "playwright": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "8.3.0"
  },
  "build": {
    "appId": "com.folio.paperreader",
    "productName": "Folio",
    "directories": {
      "output": "release/v0.4.1"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_LICENSES.txt",
      "!node_modules/**/*",
      "!dist-electron/apple-speech/**/*"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.education",
      "identity": "-",
      "target": [
        "zip"
      ],
      "icon": "build/icon.icns",
      "extraResources": [
        {
          "from": "node_modules/electron/dist/LICENSE",
          "to": "LICENSE.electron.txt"
        },
        {
          "from": "node_modules/electron/dist/LICENSES.chromium.html",
          "to": "LICENSES.chromium.html"
        },
        {
          "from": "dist-electron/apple-speech",
          "to": "apple-speech",
          "filter": [
            "Folio Speech.app/**/*"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Folio uses the microphone only when you start a voice conversation. \u70b9\u51fb\u5f00\u59cb\u8bed\u97f3\u5bf9\u8bdd\u540e\uff0cFolio \u624d\u4f1a\u4f7f\u7528\u9ea6\u514b\u98ce\u3002",
        "NSSpeechRecognitionUsageDescription": "Folio uses Apple speech recognition to turn your spoken questions into chat messages. Folio \u4f7f\u7528 Apple \u8bed\u97f3\u8bc6\u522b\u5c06\u4f60\u7684\u63d0\u95ee\u8f6c\u6362\u4e3a\u5bf9\u8bdd\u6587\u5b57\u3002"
      },
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "Folio",
      "artifactName": "Folio-${version}-mac-universal.${ext}",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 130,
          "y": 170
        },
        {
          "x": 410,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 270,
          "y": 290,
          "type": "file",
          "path": "build/INSTALL-mac.txt",
          "name": "\u5b89\u88c5\u8bf4\u660e.txt"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "en_US",
        "zh_CN"
      ],
      "artifactName": "Folio-${version}-windows-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "Folio-${version}-windows-${arch}-portable.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "role": "Viewer"
      }
    ]
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/AuroraSxh/Folio-pdfreader.git"
  }
}
